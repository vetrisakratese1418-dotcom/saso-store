# =================================================================
# saso — Server Environment Configuration
# =================================================================
# Copy to .env and fill in your values. Never commit .env to git.

PORT=4000
NODE_ENV=production

# JWT — Change this to a long random string in production
JWT_SECRET=change-me-to-a-random-64-char-string

# URLs — Your production domains
CLIENT_URL=https://yourdomain.com
API_BASE_URL=https://api.yourdomain.com
PUBLIC_BASE_URL=https://yourdomain.com

# Store
STORE_NAME=saso
STORE_EMAIL=info@yourdomain.com
STORE_PHONE=
STORE_ADDRESS=
CURRENCY=INR
CURRENCY_SYMBOL=₹

# Admin bootstrap (first user created on startup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=Change-This-Password-123!

# =================================================================
# PAYMENT GATEWAYS — Live Mode
# =================================================================

# --- Cashfree (Primary) ---
# Get keys from: https://merchant.cashfree.com/merchants/login
# Sandbox: APP_ID starts with TEST_, SECRET starts with TEST_
# Production: APP_ID starts with PROD_, SECRET starts with PROD_
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Webhook secret from Cashfree dashboard
# Set webhook URL to: https://yourdomain.com/api/payments/webhook/cashfree
CASHFREE_WEBHOOK_SECRET=

# --- Stripe ---
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- UPI (Direct) ---
UPI_VPA=
UPI_MERCHANT_NAME=saso
UPI_WEBHOOK_SECRET=
UPI_ENABLED=true

# --- Test Mode ---
ALLOW_TEST_PAYMENTS=false

# =================================================================
# EMAIL (SMTP)
# =================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# =================================================================
# DATABASE
# =================================================================
MONGODB_URI=

# =================================================================
# SHIPPING
# =================================================================
FREE_SHIPPING_THRESHOLD=499
SHIPPING_FEE=49

# =================================================================
# ANALYTICS (Optional)
# =================================================================
NEXT_PUBLIC_GA_ID=
